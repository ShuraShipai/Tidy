  "narrative": {
    "northStar": "Soft, premium digital clay",
    "overview": "Tidy is tactile, dimensional and reassuring. Its material is matte silicone: broad soft highlights, tinted reflections and gently pressed controls. Nunito brings warmth to titles and numbers while DM Sans keeps file details readable.\n\nThe product stays a storage utility first. Photo content, explicit selection states and visible review totals carry the experience. The visual identity follows the user's pinned palette and typography.",
    "keyCharacteristics": [
      "Soft dimensional surfaces.",
      "Clear file comparison and selection.",
      "Familiar iOS navigation and explicit confirmation.",
      "Restrained category color within a lavender ground."
    ],
    "rules": [
      {
        "name": "The Destructive Role Rule",
        "body": "Red is reserved for actions that remove or combine explicitly reviewed records. Standard review and navigation stay violet.",
        "section": "colors"
      },
      {
        "name": "The Separate States Rule",
        "body": "Discovered content is not selected content. Selection does not authorize deletion. Approval creates the processing queue.",
        "section": "components"
      }
    ],
    "dos": [
      "Do show literal storage numbers next to charts.",
      "Do keep selections intact through previews, category edits and canceled confirmations.",
      "Do make uncertain findings advisory and keepers changeable.",
      "Do use the native platform APIs in the production application."
    ],
    "donts": [
      "Don't surround screens with device mockups or presentation cards.",
      "Don't use color alone to indicate selection.",
      "Don't turn discovery into automatic selection or deletion.",
      "Don't present browser simulations as real authentication, permissions or storage operations."
    ]
  }
